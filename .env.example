# Google Gemini API Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# JWT Authentication Configuration
SECRET_KEY=replace_with_a_secure_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=refineai

# OCR Configuration (Optional, set path if tesseract is not in system PATH)
# On Windows e.g.: C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux/macOS usually: /usr/bin/tesseract or /usr/local/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
