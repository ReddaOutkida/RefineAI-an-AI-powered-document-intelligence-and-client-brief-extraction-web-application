# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*/__pycache__/
app/**/__pycache__/

# Environments and Secrets
.env
.env.local
.env.*.local
venv/
env/
ENV/

# User uploads (protect privacy and prevent file tracking)
app/uploads/*
!app/uploads/.gitkeep

# Node and Next.js frontend dependencies & builds
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
.pnp
.pnp.js

# Logs and Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tsbuildinfo
